# Optional, consent-gated measurement. Keep this false or unset for local and
# preview deployments so they never send events to the production projects.
# Production tracking requires NEXT_PUBLIC_ANALYTICS_ENABLED=true.
NEXT_PUBLIC_ANALYTICS_ENABLED=false

# Public browser configuration. Add real values in Vercel; do not commit them.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=
NEXT_PUBLIC_META_PIXEL_ID=
